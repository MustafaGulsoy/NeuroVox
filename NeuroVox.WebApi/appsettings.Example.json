{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "CORS": { "AllowedOrigins": "http://localhost:4200" },
  "Swagger": { "Enabled": false },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "IpWhitelist": [],
    "EndpointWhitelist": [ "get:/health" ],
    "ClientWhitelist": [],
    "GeneralRules": [
      { "Endpoint": "*", "Period": "1s", "Limit": 10 },
      { "Endpoint": "*", "Period": "1m", "Limit": 100 },
      { "Endpoint": "*", "Period": "1h", "Limit": 1000 }
    ]
  },
  "Auth": {
    "Token": { "Audience": "https://neurovox-api.com", "Issuer": "https://neurovox-api.com", "SecurityKey": "CHANGE_ME_use_at_least_32_random_characters" },
    "ConnectionString": "Host=localhost;Port=5432;Database=NeuroVoxDb;Username=user;Password=CHANGE_ME",
    "ContextSchema": "auth",
    "LogTable": "logs"
  },
  "NeuroVox": {
    "ConnectionString": "Host=localhost;Port=5432;Database=NeuroVoxDb;Username=user;Password=CHANGE_ME",
    "ContextSchema": "neurovox",
    "AiBaseUrl": "http://localhost:8000/",
    "AiApiKey": "CHANGE_ME",
    "AudioStoragePath": "data/audio",
    "AutoMigrate": true
  }
}
