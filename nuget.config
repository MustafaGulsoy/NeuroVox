<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Private Nexus (docker container `nexus`, data volume nexus-data on the VPS). Anonymous read; plain HTTP for now. -->
    <add key="neurovox-nexus" value="http://69.62.120.208:1010/repository/nuget-hosted/index.json" protocolVersion="3" allowInsecureConnections="true" />
  </packageSources>
  <!-- Dependency-confusion guard: BaseAuth.* may only come from Nexus, everything else from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="neurovox-nexus">
      <package pattern="BaseAuth.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
