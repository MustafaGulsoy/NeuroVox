# cp .env.example .env  — then replace every value. Never commit .env.
POSTGRES_USER=neurovox
POSTGRES_PASSWORD=
# >= 32 random chars, e.g. `openssl rand -base64 48`. Shared by the API and the BaseAuth service.
JWT_SECURITY_KEY=
JWT_ISSUER=https://auth.example.org
JWT_AUDIENCE=https://api.example.org
CORS_ALLOWED_ORIGINS=https://app.example.org
# Shared secret between API and AI service: `openssl rand -hex 32`
AI_API_KEY=
STT_MODEL=small
# Tenant (customer) GUID the SPA sends as the customerid header; see README for first-time seeding.
CUSTOMER_ID=
# AES-256 key for stored Kaggle tokens: `openssl rand -base64 32`. Losing it makes stored tokens unreadable (re-add them).
NEUROVOX_SECRET_KEY=
PUBLIC_API_URL=https://api.example.org
# AI host: default is the local `ai` container (start with --profile localai). Kaggle accounts added in the UI
# (Yönetim > Kaggle, system admin only) take precedence; the kernel starts on demand. AI_BASE_URL=none disables the local fallback.
#AI_BASE_URL=
#AI_UPLOAD=
